// P07 isolated Care AI Meta messaging Worker (Messenger + Instagram).
// Isolated from coachkenjipham.com production runtime: workers.dev only, no routes/custom domains.
// Founder-gated bounded structured durable-memory release is source-pinned for auditability; secrets and channel/customer operational gates remain dashboard-managed and survive Git deploys via keep_vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "p07-care-ai-meta-test",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "CLOUDFLARE_PORTABILITY_PROOF": "1",
    "CARE_AI_TEST_RUNTIME_SURFACE": "cloudflare-preview",
    "CARE_AI_TEST_UI_ENABLED": "true",
    "CARE_AI_TEST_REVIEW_HOST": "p07-care-ai-meta-test.kenjipham-bht.workers.dev",
    "CARE_AI_TEST_REVIEW_EXPIRES_AT": "2026-09-05T23:59:59+07:00",
    "CARE_P09_REVIEW_RUNNER_ENABLED": "true",
    "CARE_P09_REVIEW_MODEL_PROVIDER": "google_gemini",
    "CARE_P09_REVIEW_MODEL_NAME": "gemini-3.5-flash-lite",
    "CARE_MODEL_PROVIDER": "google_gemini",
    "CARE_MODEL_NAME": "gemini-3.5-flash-lite",
    "CARE_MODEL_ALLOWED_COMPATIBLE_HOSTS": "",
    "CARE_META_SANDBOX_ENABLED": "true",
    "CARE_META_MESSENGER_SEND_ENDPOINT": "https://graph.facebook.com/v26.0/102524972270814/messages",
    "CARE_META_IDEMPOTENCY_TTL_SECONDS": "86400",
    "CARE_META_DURABLE_MEMORY_READ_ENABLED": "true",
    "CARE_META_DURABLE_MEMORY_WRITE_ENABLED": "true",
    "CARE_MEMORY_PURPOSE_SCOPE": "PUBLIC_CARE",
    "CARE_MEMORY_CONTRACT_VERSION": "p09-memory-v0.3",
    "CARE_MEMORY_READ_KEYS": "self_stated_current_need,product_journey_explored,conversation_open_loop,explicit_preference,selected_next_step",
    "CARE_MEMORY_WRITE_KEYS": "self_stated_current_need,product_journey_explored,conversation_open_loop,explicit_preference,selected_next_step",
    "CARE_MEMORY_ITEMS_MAX": "10",
    "CARE_MEMORY_CHARS_MAX": "2500"
  },
  "d1_databases": [
    {
      "binding": "CARE_META_IDEMPOTENCY_DB",
      "database_name": "care-meta-idempotency",
      "database_id": "09d17d94-2325-4afb-9500-ddac0c31e275"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "p07-care-ai-meta-test"
    }
  ],
  "workers_dev": true,
  "preview_urls": true
}
