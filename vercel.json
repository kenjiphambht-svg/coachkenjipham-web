{
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/kidbook",
      "destination": "/an-pham-ban-sac-hat-mam",
      "permanent": true
    },
    {
      "source": "/thanh-toan-goi-1",
      "destination": "/an-pham-ban-sac-hat-mam",
      "permanent": true
    },
    {
      "source": "/thanh-toan-goi-2",
      "destination": "/an-pham-ban-sac-hat-mam",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
