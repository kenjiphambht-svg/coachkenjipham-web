// P07 bounded Messenger/Page controlled-live Stage A configuration.
// Founder-approved Page: Kenji Phạm - Essence (102524972270814). Secrets remain runtime-only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "essence-web-portability-proof",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "vars": {
    "CLOUDFLARE_PORTABILITY_PROOF": "1",
    "CARE_AI_TEST_RUNTIME_SURFACE": "cloudflare-preview",
    "CARE_AI_TEST_UI_ENABLED": "true",
    "CARE_AI_TEST_REVIEW_HOST": "backend-p07-care-ai-test-con-01b5-essence-web-portability-proof.kenjipham-bht.workers.dev",
    "CARE_AI_TEST_REVIEW_EXPIRES_AT": "2026-09-05T23:59:59+07:00",
    "CARE_P09_REVIEW_RUNNER_ENABLED": "true",
    "CARE_P09_REVIEW_MODEL_PROVIDER": "google_gemini",
    "CARE_P09_REVIEW_MODEL_NAME": "gemini-3.5-flash-lite",
    "CARE_MODEL_PROVIDER": "google_gemini",
    "CARE_MODEL_NAME": "gemini-3.5-flash-lite",
    "CARE_MODEL_ALLOWED_COMPATIBLE_HOSTS": "",
    "CARE_META_SANDBOX_ENABLED": "true",
    "CARE_META_LIVE_TEST_ENABLED": "false",
    "CARE_META_OUTBOUND_ENABLED": "false",
    "CARE_META_MESSENGER_SEND_ENDPOINT": "https://graph.facebook.com/v26.0/102524972270814/messages",
    "CARE_META_TEST_SENDER_IDS": "",
    "CARE_META_IDEMPOTENCY_TTL_SECONDS": "86400"
  },
  "secrets": {
    "required": ["CARE_AI_TEST_ACCESS_TOKEN"]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "essence-web-portability-proof"
    }
  ],
  "workers_dev": true,
  "preview_urls": true
}
